    "python -m src.build_graphs --dataset mtat --audio-root /data/raw/magnatagatune/audio --mtat-dir /data/raw/magnatagatune --no-mel --workers 8 --out /data/processed --n-examples 25",
    "python -m src.build_graphs --dataset musiccaps --musiccaps-dir /data/raw/musiccaps_audio --musiccaps-csv /data/raw/musiccaps/musiccaps-public.csv --no-mel --workers 8 --out /data/processed --n-examples 0",
    "python -m src.train --dataset musiccaps --epochs 6 --save-checkpoint",
    "python -m src.train --dataset musiccaps --epochs 6 --strip-leakage --save-checkpoint",
    "python -m src.train --dataset mtat --epochs 6 --save-checkpoint",
    "python -m src.train_gnn --cache /data/processed/fma_small_graphs.pt --model all --epochs 40",
    "python -m src.train_b4  --cache /data/processed/fma_small_graphs.pt --out results/metrics_task2_b4.json",
    "python -m src.train_fusion --mode all --epochs 8 --deam-cache /nonexistent --out-dir results",
    "python -m src.train_fusion --mode crossattn --epochs 8 --gnn-lr 1e-3 --deam-cache /nonexistent --out-dir results/_gnnlr",
    "python -m src.train_fusion --mode crossattn --epochs 8 --freeze-bert --deam-cache /nonexistent --out-dir results/_freeze",
    "python -m src.train_contrastive --cache /data/processed/musiccaps_graphs.pt --epochs 30 --out-dir results",
    "python -m src.analyze_fusion --checkpoint results/task3_crossattn.pt --cache /data/processed/mtat_graphs.pt --out-dir results",
    "python -m src.make_plots --results results --out results/plots"
