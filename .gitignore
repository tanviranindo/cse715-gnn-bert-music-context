__pycache__/
*.pyc
.venv/
venv/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.pt
.ipynb_checkpoints/
.DS_Store

# The >=20 example graphs are a hard submission requirement (spec S10),
# so they must be committed despite the *.pt and data/processed rules above.
# Both corpora: FMA (50 graphs) and MagnaTagATune (105), which the report
# counts together as 155.
!data/processed/graph_samples/
!data/processed/graph_samples/**
!data/processed/graph_samples_mtat/
!data/processed/graph_samples_mtat/**

# Deterministic split manifests (spec S10 names data/splits/ in the tree)
!data/splits/*.json

# Dashboard runtime state (regenerated by update_status.sh each poll)
.prev_state.json
status.json

# Model checkpoints pulled down from rented instances. The weights themselves
# are 253 MB each (over GitHub's limit), but their checksums and the exact
# commands that regenerate them are committed so a grader can verify or rebuild.
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
!artifacts/checkpoints/SHA256SUMS
!artifacts/checkpoints/README.md

# Notebook execution scratch (EDA downloads ~35 MB of metadata on demand)
notebooks/_eda_cache/
notebooks/_exec_*.ipynb
.ipynb_checkpoints/

# LaTeX build products
report/*.aux
report/*.log
report/*.out

# Vercel CLI link + pulled env (never commit tokens)
.vercel/
*.env.local
